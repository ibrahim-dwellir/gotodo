    {
      "type": "flamegraph",
      "id": 19,
      "title": "Blocking",
      "description": "Call sites blocked on channels, select and sync primitives, weighted by time blocked. The net/http/pprof.Profile stack is the CPU profile scrape itself; search past it or click a sibling frame to focus on the app.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
