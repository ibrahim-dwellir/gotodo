        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Blocking time",
      "description": "Time goroutines spent blocked on channels, select and sync primitives, per second (sampled). Includes the profiler's own CPU profile request, which sleeps for most of every scrape interval (net/http/pprof.Profile in the Blocking flame graph).",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "block:delay:nanoseconds:contentions:count",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [
            "instance"
          ],
          "spanSelector": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.instance}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 8,
      "title": "CPU",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "flamegraph",
      "id": 9,
      "title": "CPU",
      "description": "Where CPU time went over the selected time range. Wider = more CPU. Click a frame to zoom; use the search box to highlight a function.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {}
    },
    {
      "type": "row",
      "id": 10,
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "flamegraph",
      "id": 11,
      "title": "Allocations (bytes)",
      "description": "Code that allocated the most heap memory over the time range. Drives GC work; reduce these to cut CPU spent in GC.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "memory:alloc_space:bytes:space:bytes",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {}
    },
    {
      "type": "flamegraph",
      "id": 12,
      "title": "Heap in use (bytes)",
      "description": "Code that allocated the memory still live on the heap; look here for leaks and large caches. Each scrape is a snapshot and the graph adds up every snapshot in the time range, so the total is larger than the real heap. Narrow the range (e.g. 5m) for a point-in-time view; compare shapes, not totals.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "memory:inuse_space:bytes:space:bytes",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {}
    },
    {
      "type": "flamegraph",
      "id": 13,
      "title": "Allocations (objects)",
      "description": "Number of objects allocated, by call site.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
