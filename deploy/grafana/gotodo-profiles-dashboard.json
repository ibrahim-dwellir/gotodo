          },
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "memory:alloc_objects:count:space:bytes",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [],
          "spanSelector": []
        }
      ],
      "options": {}
    },
    {
      "type": "flamegraph",
      "id": 14,
      "title": "Heap in use (objects)",
      "description": "Live heap objects by call site, summed over every snapshot in the time range (see Heap in use (bytes)).",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 51,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
