{
  "uid": "gotodo-profiles",
  "title": "GoTodo profiles",
  "description": "Continuous profiling for GoTodo from Pyroscope: CPU, memory, goroutines and contention.",
  "tags": [
    "gotodo",
    "go",
    "pyroscope",
    "profiling"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "links": [
    {
      "title": "GoTodo dashboards",
      "type": "dashboards",
      "tags": [
        "gotodo"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "grafana-pyroscope-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "type": "labelValue",
          "labelName": "service_name",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "refId": "service-var"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {
          "selected": true,
          "text": "gotodo",
          "value": "gotodo"
        }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "grafana-pyroscope-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "type": "labelValue",
          "labelName": "instance",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "refId": "instance-var"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "options": [],
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "CPU",
      "description": "CPU used by the process, from the CPU profile (1 = one core).",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [
            "instance"
          ],
          "spanSelector": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.instance}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Heap in use",
      "description": "Live heap memory at each scrape.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "memory:inuse_space:bytes:space:bytes",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [
            "instance"
          ],
          "spanSelector": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.instance}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Allocation rate",
      "description": "Heap bytes allocated per second.",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "memory:alloc_space:bytes:space:bytes",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [
            "instance"
          ],
          "spanSelector": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.instance}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
