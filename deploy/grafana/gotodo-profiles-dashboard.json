      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "goroutine:goroutine:count:goroutine:count",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [
            "instance"
          ],
          "spanSelector": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.instance}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": 120000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Mutex wait",
      "description": "Time goroutines spent waiting on contended mutexes, per second (sampled).",
      "datasource": {
        "type": "grafana-pyroscope-datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-pyroscope-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "queryType": "metrics",
          "profileTypeId": "mutex:delay:nanoseconds:contentions:count",
          "labelSelector": "{service_name=\"$service\", instance=~\"${instance:regex}\"}",
          "groupBy": [
            "instance"
          ],
          "spanSelector": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.instance}",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "axisSoftMin": 0,
            "spanNulls": 120000
          }
